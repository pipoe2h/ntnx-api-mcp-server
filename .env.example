# ── Prism Central connection ──────────────────────────────────────────────────
# IP address or FQDN only — no "https://" prefix, no trailing slash.
# Example: PC_HOST=10.1.1.10  or  PC_HOST=prism.example.com
PC_HOST=10.1.1.10
PC_PORT=9440

# ── Authentication (choose one) ───────────────────────────────────────────────
# Option A — basic auth (username + password)
PC_USERNAME=admin
PC_PASSWORD=changeme

# Option B — API key (sent as X-ntnx-api-key header)
# Mutually exclusive with Option A — set one or the other, not both.
PC_API_KEY=

# ── TLS ───────────────────────────────────────────────────────────────────────
# false = enforce TLS certificate verification (default; recommended for production)
# true  = skip certificate verification (use only for dev/test with self-signed certs)
PC_INSECURE=false

# ── Artifact storage ──────────────────────────────────────────────────────────
# Absolute path to the directory where downloaded OpenAPI YAML specs are stored.
# Created automatically on first run. Must be absolute when used in AI client
# config files (mcp.json / claude_desktop_config.json) — relative paths are not
# resolved from the config file location.
# Example: ARTIFACTS_DIR=/home/user/.nutanix-mcp/artifacts
ARTIFACTS_DIR=./artifacts

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT: text | json  (default: text; use json for log aggregation pipelines)
LOG_FORMAT=text
# Absolute path for per-restart log files. A timestamped file is created each startup.
LOG_DIR=./logs

# ── Namespace discovery ───────────────────────────────────────────────────────
# Endpoint that returns the list of available API namespaces.
# Override only when mirroring the Nutanix developer portal on a private network.
NAMESPACE_SOURCE_URL=https://developers.nutanix.com/api/v1/namespaces

# ── Runtime controls ──────────────────────────────────────────────────────────
# READ_ONLY_MODE: set to "true" to block all non-GET operations server-side.
# Default: false (read + write enabled)
READ_ONLY_MODE=false
